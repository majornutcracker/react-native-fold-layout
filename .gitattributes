# Normalize line endings on checkin; check out native to the platform.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jks binary
*.keystore binary

# The example app is a test bed, not the published library.
example/** linguist-documentation

# Lockfiles are generated: collapse them in PR diffs.
yarn.lock -diff linguist-generated
example/yarn.lock -diff linguist-generated
